# Template — copiar para local.properties e preencher com as chaves reais
# NUNCA commitar o local.properties preenchido

# Caminho do Android SDK (ajuste para seu ambiente)
sdk.dir=C\:\\Users\\<usuario>\\AppData\\Local\\Android\\Sdk

# Chaves HMAC — obter no secret manager corporativo
# Sem essas chaves o build de release ABORTA (comportamento intencional).
# Build de debug usa DEV_ONLY_FALLBACK_NEVER_RELEASE se ausentes.
HUGINN_QR_HMAC_KEY=sua_chave_qr_aqui
HUGINN_TOKEN_HMAC_KEY=sua_chave_token_aqui
